# Koode — production environment (cPanel / WHM).
# Copy to .env.local on the server and fill in. NEVER commit the filled file.
#
#   cp .env.production.example .env.local && nano .env.local

# --- Database ---------------------------------------------------------------
# The MySQL database + user you created in cPanel (MySQL Databases).
# Host is 127.0.0.1 for a DB on the same server. The user needs privileges on
# THIS schema only (cPanel grants that when you "Add User To Database").
DATABASE_URL="mysql://koodeorg_app:CHANGE_ME@127.0.0.1:3306/koodeorg_koode"

# --- Redis (required in production) -----------------------------------------
# Local Redis on the box. If the server has no Redis, see DEPLOY-CPANEL.md.
REDIS_URL="redis://127.0.0.1:6379"

# --- Secrets (>= 32 chars each; generate, do not invent) --------------------
#   openssl rand -base64 48
SESSION_SECRET="CHANGE_ME_openssl_rand_base64_48"
IP_HASH_SECRET="CHANGE_ME_a_different_openssl_rand_base64_48"

# --- Public URL (must be https in production) -------------------------------
NEXT_PUBLIC_APP_URL="https://koode.org"

# --- Google sign-in (optional; blank hides the button) ----------------------
# Authorised redirect URI in Google Cloud must be exactly:
#   https://koode.org/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- SMS: leave as console. The claim flow that needs real SMS stays off ----
SMS_PROVIDER="console"
ALLOW_RECOMMENDING_NON_USERS="false"

# --- Admin bootstrap: phone numbers that become admins when seeded ----------
SEED_ADMIN_PHONES=""

# --- Maintenance endpoint guard (optional) ----------------------------------
MAINTENANCE_SECRET=""
