# Koode — environment template
# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. `.env.local` is gitignored and must never
# be committed. Every value below is blank or an obvious placeholder on purpose.
#
#   cp .env.example .env.local
#
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# MySQL 8.0+. The schema name is capitalised `Koode`; on Linux, database names
# are case-sensitive, so it must match exactly. Create it with:
#   CREATE DATABASE `Koode` CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
#
# Local development against the bundled Docker Compose service:
#   mysql://root:CHANGE_ME@127.0.0.1:3306/Koode
#
# NEVER use `root` outside local development. Production must use a dedicated
# application user scoped to the `Koode` schema (see ARCHITECTURE.md §Database).
DATABASE_URL=

# --- Redis (rate limiting) --------------------------------------------------
# Leave blank in local development to fall back to an in-process limiter.
# The fallback is single-process only and MUST NOT be used in production.
REDIS_URL=

# --- Session / crypto -------------------------------------------------------
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this invalidates every session and every outstanding claim link.
SESSION_SECRET=

# Separate secret used to salt hashed IP addresses in the audit log, so that
# audit data cannot be correlated back to raw IPs even with database access.
IP_HASH_SECRET=

# --- SMS --------------------------------------------------------------------
# `console` writes the OTP to the server log and sends nothing. It is the only
# supported provider until a real one is chosen.
# Allowed: console
SMS_PROVIDER=console

# --- Google sign-in (optional) ----------------------------------------------
# A convenience credential only: identity stays the phone number, and Google
# can be attached to an account from the profile page. Leave both blank to
# hide the feature entirely.
#
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud
# Console and register this redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Application ------------------------------------------------------------
# Public origin, used for claim links in SMS. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fail-closed switch for the one legally sensitive capability: recommending a
# person who is not yet a user. Requires a real SMS provider to be safe, so it
# stays `false` until one is configured. See ARCHITECTURE.md §Third-party data.
ALLOW_RECOMMENDING_NON_USERS=false

# Shared secret for POST /api/maintenance, called by cron. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leaving it blank DISABLES the endpoint — which also disables the automatic
# purge of unclaimed profiles, so it must be set before launch.
MAINTENANCE_SECRET=

# Comma-separated E.164 numbers granted the platform `admin` role by the seed
# script. Development convenience only; production grants roles via the console.
SEED_ADMIN_PHONES=
